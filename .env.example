# App Root（被打包的 Flutter 工程绝对路径；勿提交真实本机路径到仓库）
APP_ROOT=/absolute/path/to/your-flutter-app

# H5 Agent（本机回环控制面；外网需运维自行开 Tunnel，如 cpolar）
# AGENT_ACCESS_TOKEN=replace-with-a-long-shared-secret
# AGENT_PORT=8787
# AGENT_HOST=127.0.0.1

# 蒲公英 API Key（https://www.pgyer.com/account/api）— Console 只显示是否已配置，不在此 UI 编辑
PGYER_API_KEY=

# 可选：默认打包目标（也可由 CLI --platform/--mode 或 Console 选择器覆盖）
# PACK_PLATFORM=android
# PACK_MODE=debug

# 可选：安装方式 1=公开 2=密码 3=邀请
# PGYER_INSTALL_TYPE=1
# PGYER_PASSWORD=
# 可选：蒲公英「更新说明」（Console「安装说明」输入框会覆盖本次 Run）
# PGYER_UPDATE_DESCRIPTION=

# 可选：蒲公英「合并安装页」URL（多平台上传成功后优先打开这一页的二维码）
# 需先在蒲公英后台做「应用合并」；未配置则弹同窗多卡（每平台一张码）
# PGYER_MERGED_INSTALL_URL=

# 可选：iOS IPA 导出方式（flutter --export-method）
# 未设置时：release → ad-hoc（蒲公英/真机），debug → development
# IOS_EXPORT_METHOD=ad-hoc
# IOS_EXPORT_METHOD=app-store
# 或提供完整 ExportOptions.plist（优先于 IOS_EXPORT_METHOD）
# IOS_EXPORT_OPTIONS_PLIST=/absolute/path/to/ExportOptions.plist
